NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54331
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-key-from-supabase-status
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:4173
CLIQO_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=
CLIQO_SMTP_HOST=127.0.0.1
CLIQO_SMTP_PORT=54335
CLIQO_SMTP_SECURE=false
CLIQO_SMTP_REQUIRE_TLS=false
CLIQO_SMTP_USER=
CLIQO_SMTP_PASSWORD=
CLIQO_EMAIL_FROM=noreply@cliqo.test
CLIQO_EMAIL_FROM_NAME=CliQo
CLIQO_ORDER_ACCESS_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
CLIQO_EMAIL_CRON_SECRET=replace-with-a-different-random-secret-at-least-32-characters
# Optional card checkout. Keep every Paymob secret server-side; leave blank until the merchant account and HTTPS domain are ready.
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_MODE=test
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_CARD_INTEGRATION_ID=
CLIQO_PUBLIC_ORIGIN=
CLIQO_ALLOW_PAYMOB_SANDBOX=false

CLIQO_ACTIVATION_MASTER_KEY=

# Private recipient for the admin's prefilled WhatsApp design requests.
# Use the international number, e.g. +20..., and set it only in the server environment.
CLIQO_DESIGNER_WHATSAPP=

# Owner-only private checkout. Uses isolated test inventory while public sales remain closed.
CLIQO_ENABLE_TEST_CHECKOUT=false
