# Copy to app.env on the server. Never commit app.env.
# These public values are also embedded into the browser bundle at build time.
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SUPABASE_URL=https://api.example.com
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-production-publishable-key
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Transactional email. Use an authenticated sender from the CliQo domain in production.
CLIQO_SMTP_HOST=smtp.example.com
CLIQO_SMTP_PORT=587
CLIQO_SMTP_SECURE=false
CLIQO_SMTP_REQUIRE_TLS=true
CLIQO_SMTP_USER=replace-with-smtp-user
CLIQO_SMTP_PASSWORD=replace-with-smtp-password
CLIQO_EMAIL_FROM=noreply@cliqo.example
CLIQO_EMAIL_FROM_NAME=CliQo

# Private owner-only inbox in /cliqo-control/email. Store real mailbox passwords in app.env only.
CLIQO_MAIL_IMAP_HOST=mail.cliqoeg.com
CLIQO_MAIL_SMTP_HOST=mail.cliqoeg.com
CLIQO_MAIL_INFO_PASSWORD=replace-with-info-mailbox-password
CLIQO_MAIL_CONTACTS_PASSWORD=replace-with-contacts-mailbox-password
CLIQO_MAIL_ADMIN_PASSWORD=replace-with-admin-mailbox-password
CLIQO_ORDER_ACCESS_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
CLIQO_EMAIL_CRON_SECRET=replace-with-a-different-random-secret-at-least-32-characters

# Optional Paymob hosted card checkout. Use test keys first; never expose secrets in NEXT_PUBLIC_* variables.
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_MODE=test
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_CARD_INTEGRATION_ID=
CLIQO_PUBLIC_ORIGIN=https://example.com
CLIQO_ALLOW_PAYMOB_SANDBOX=false

# Internal-only values. Use the Supabase Docker service names on the shared network.
SUPABASE_INTERNAL_URL=http://kong:8000
CLIQO_DATABASE_URL=postgresql://postgres:replace-password@db:5432/postgres
SUPABASE_SECRET_KEY=replace-with-production-secret-key
CLIQO_SUPABASE_NETWORK=replace-with-actual-supabase-network-name

# 64 hex characters; keep stable so planned unit activation codes remain recoverable.
CLIQO_ACTIVATION_MASTER_KEY=

# Owner-only private checkout. Uses isolated test inventory while public sales remain closed.
CLIQO_ENABLE_TEST_CHECKOUT=false
