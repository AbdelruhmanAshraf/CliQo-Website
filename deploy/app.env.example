# Copy to app.env on the server. Never commit app.env.
# These public values are also embedded into the browser bundle at build time.
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SUPABASE_URL=https://api.example.com
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-production-publishable-key
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Internal-only values. Use the Supabase Docker database service name on the shared network.
CLIQO_DATABASE_URL=postgresql://postgres:replace-password@db:5432/postgres
SUPABASE_SECRET_KEY=replace-with-production-secret-key
CLIQO_SUPABASE_NETWORK=replace-with-actual-supabase-network-name
